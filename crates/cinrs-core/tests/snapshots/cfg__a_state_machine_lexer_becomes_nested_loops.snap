                                if (*p) as ::core::ffi::c_int == 0 {
                                    strings = strings.wrapping_sub(1);
                                    break 'start;
                                } else {
                                    if (*p) as ::core::ffi::c_int != 34 {
                                        continue 'in_string;
                                    }
                                    p = p.offset(1);
                                    strings = strings.wrapping_add(1);
                                    break 'in_string;
                                }
                            }
                        } else {
                            if (*p) as ::core::ffi::c_int == 47 {
                                p = p.offset(1);
                                if (*p) as ::core::ffi::c_int != 42 {
                                    punct = punct.wrapping_add(1);
                                } else {
                                    p = p.offset(1);
                                    'in_comment: loop {
                                        if (*p) as ::core::ffi::c_int == 0 {
                                            break 'start;
                                        }
                                        if (*p) as ::core::ffi::c_int == 42 {
                                            p = p.offset(1);
                                            if !((*p) as ::core::ffi::c_int != 47) {
                                                break 'in_comment;
                                            }
