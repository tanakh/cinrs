pub unsafe extern "C" fn f(mut p: *const ::core::ffi::c_char) -> ::core::ffi::c_int {
    unsafe {
        let mut words: ::core::ffi::c_int = 0;
        let mut numbers: ::core::ffi::c_int = 0;
        let mut strings: ::core::ffi::c_int = 0;
        let mut comments: ::core::ffi::c_int = 0;
        let mut punct: ::core::ffi::c_int = 0;
        words = 0;
        numbers = 0;
        strings = 0;
        comments = 0;
        punct = 0;
        'start: loop {
            if (*p) as ::core::ffi::c_int == 0 {
                break 'start;
            }
            if (*p) as ::core::ffi::c_int == 32 {
                p = p.offset(1);
            } else {
                if (*p) as ::core::ffi::c_int >= 97 && (*p) as ::core::ffi::c_int <= 122
                {
                    'in_word: loop {
                        p = p.offset(1);
                        if !((*p) as ::core::ffi::c_int >= 97
                            && (*p) as ::core::ffi::c_int <= 122
                            || (*p) as ::core::ffi::c_int >= 48
                                && (*p) as ::core::ffi::c_int <= 57)
                        {
                            break 'in_word;
                        }
                    }
                    words = words.wrapping_add(1);
                } else {
                    if (*p) as ::core::ffi::c_int >= 48
                        && (*p) as ::core::ffi::c_int <= 57
                    {
                        'in_number: loop {
                            p = p.offset(1);
                            if !((*p) as ::core::ffi::c_int >= 48
                                && (*p) as ::core::ffi::c_int <= 57)
                            {
                                break 'in_number;
                            }
